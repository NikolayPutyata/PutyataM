# Необовʼязково. Скопіюй у .env.local і впиши значення (файл .env.local не потрапляє в git).
# ID Google Tag Manager — коли створиш акаунт:
NEXT_PUBLIC_GTM_ID=
# Тестова копія сайту, закрита від Google (для weksar.com залиш порожнім):
NEXT_PUBLIC_SITE_ENV=
# Інша адреса сервера заявок (за замовчуванням — unium-server на DigitalOcean):
NEXT_PUBLIC_LEAD_ENDPOINT=
