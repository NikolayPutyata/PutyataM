# Новий сайт (Next.js, статичний експорт) на Apache (фрихост).
# Чернетка для Фази 5: тут ще будуть 301-редиректи зі старих адрес (docs/seo-structure.md, розділ 7).

DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www і дзеркала → https://weksar.com
  RewriteCond %{HTTP_HOST} !^weksar\.com$ [NC]
  RewriteCond %{HTTP_HOST} ^(www\.)?weksar\.com(\.ua)?$ [NC]
  RewriteRule ^ https://weksar.com%{REQUEST_URI} [R=301,L]

  # Адреса зі слешем у кінці → без слеша (одна канонічна адреса)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /likvidatsiia-tov → likvidatsiia-tov.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ $1.html [L]

  ErrorDocument 404 /404.html
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
